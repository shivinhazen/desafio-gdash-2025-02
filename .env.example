# MongoDB
MONGO_URI=mongodb://mongo:27017/gdash

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=weather-logs

# API / Authentication
API_URL=http://api:3000
JWT_SECRET=gdash-secret-token-change
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=123456

# Collector Python
COLLECTOR_LATITUDE=-22.7752
COLLECTOR_LONGITUDE=-41.9134
COLLECTOR_CITY=Búzios
COLLECTOR_QUEUE=weather-logs
COLLECTOR_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
COLLECTOR_INTERVAL_SECONDS=600

# Worker Go
WORKER_API_URL=http://api:3000/api/weather/logs
WORKER_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
WORKER_QUEUE=weather-logs

# Weather sync (novo collector)
SYNC_CITY=Búzios
SYNC_LATITUDE=-22.7752
SYNC_LONGITUDE=-41.9134
SYNC_TIMEZONE=America/Sao_Paulo

# Janela para seed (histórico) e loop (quase realtime)
SYNC_PAST_DAYS_SEED=30
SYNC_FUTURE_DAYS_SEED=2

SYNC_PAST_DAYS_LOOP=2
SYNC_FUTURE_DAYS_LOOP=2
SYNC_LOOP_INTERVAL_SECONDS=900

# Broker (rodando o Python no WSL, falando com o RabbitMQ exposto pelo Docker)
SYNC_BROKER_URL=amqp://guest:guest@localhost:5672/
SYNC_QUEUE=weather-logs

# Label da fonte
SYNC_SOURCE_LABEL=open-meteo-sync
